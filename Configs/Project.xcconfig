//
//  Project.xcconfig
//  demomoni-remake-ios
//
//  プロジェクト共通のビルド設定（template-app-ios と同じ構成）。
//  署名情報・Bundle Identifier・バージョン・Deployment Target は pbxproj 側に直接書かず、ここだけを編集する。
//

// Apple Developer Program の Team ID
DEVELOPMENT_TEAM = XU74X3434S

// アプリ本体の Bundle Identifier。
// テストターゲットは $(APP_BUNDLE_IDENTIFIER).Tests / .UITests として派生させる
APP_BUNDLE_IDENTIFIER = jp.shilokuma.Demomoni

// バージョン（CFBundleShortVersionString / CFBundleVersion）
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// 最低サポート OS（iPhone / iPad。Liquid Glass の API を分岐なしで使うため iOS 26 以上）
IPHONEOS_DEPLOYMENT_TARGET = 26.0

// ホーム画面に出すアプリ名（元アプリの CFBundleName と同じ）
INFOPLIST_KEY_CFBundleDisplayName = でももに！

// 位置情報（使用中の許可）の利用目的。さがすタブで近くの iBeacon を見つけるために使う
INFOPLIST_KEY_NSLocationWhenInUseUsageDescription = 近くのビーコンを見つけて、ピースをゲットするために使います

// 輸出コンプライアンスの申告（Info.plist の ITSAppUsesNonExemptEncryption）。免除対象外の暗号を使わないので NO。暗号を入れるときは見直す
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO
